# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
# EAS signing secrets — keystore passwords live here, never commit
credentials.json
credentials/
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# fastlane / Ruby bundle (Google Play delivery) — see fastlane/README.md
# Track .bundle/config (BUNDLE_PATH only, no secrets) so `bundle install` vendors
# gems on a fresh clone — macOS system Bundler otherwise needs sudo.
/.bundle/*
!/.bundle/config
/vendor/
fastlane/report.xml
fastlane/test_output/
# Google Play service-account key — NEVER commit (keep real keys outside the repo)
fastlane/play-service-account.json
fastlane/*.service-account.json
# EAS build artifact downloaded locally for a fastlane upload
/build/
*.aab
