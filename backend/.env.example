# Videos feature — pick the host with VIDEO_PROVIDER: 'cloudflare' or 'mux'
VIDEO_PROVIDER=cloudflare

# Cloudflare Stream (when VIDEO_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Mux (when VIDEO_PROVIDER=mux) — dashboard.mux.com → Settings → Access Tokens (Video read+write)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Daily.co — live streaming rooms and meeting tokens
# Get from: https://dashboard.daily.co → Settings → API keys
DAILY_API_KEY=

# MSG91 — SMS transport for phone-login OTPs (India). We generate/verify the
# OTP ourselves; MSG91's Flow API just delivers it via a DLT-approved template.
# Get these from: https://control.msg91.com → Settings → API
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=          # DLT-approved Flow template with ONE variable for the code
MSG91_OTP_VAR=otp              # the template's variable name for the code (use 'var1' for positional templates)
MSG91_SENDER_ID=               # optional 6-char DLT sender/header
MSG91_DEFAULT_COUNTRY_CODE=91  # prefixed to bare 10-digit numbers
# MSG91_BASE_URL=              # optional API host override (default https://control.msg91.com)

# Cloudinary — PRIVATE seller KYC media (store doc, government ID, selfie).
# The API key + secret are SERVER-ONLY (never expose them to the app). With
# them set, KYC images upload as type=authenticated and are only viewable via a
# short signed URL the backend mints for the owner/admin. Without them, KYC
# upload returns 503 and the app falls back to the legacy public path.
# Cloud name reuses the existing EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME if unset.
# Get from: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
