# Videos feature — pick the host with VIDEO_PROVIDER: 'cloudflare' or 'mux'
VIDEO_PROVIDER=cloudflare

# Cloudflare Stream (when VIDEO_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Mux (when VIDEO_PROVIDER=mux) — dashboard.mux.com → Settings → Access Tokens (Video read+write)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
